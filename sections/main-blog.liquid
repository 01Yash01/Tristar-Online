{% comment %}
  Section contract.
  Blog listing: the latest post as a large featured card, a tag filter, then a paginated grid.
  The featured card shows only on the first unfiltered page.
  @example
  <!-- Rendered by templates/blog.json for /blogs/<handle> and /blogs/<handle>/tagged/<tag> -->
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign columns = section.settings.columns | default: 3
  assign posts_per_page = section.settings.posts_per_page | default: 9

  # Grid images: 1 column on phones, 2 on tablets, the chosen count on desktop
  assign grid_vw = 100 | divided_by: columns
  capture grid_sizes
    echo '(min-width: 990px) ' | append: grid_vw | append: 'vw, (min-width: 750px) 50vw, 100vw'
  endcapture
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    section
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    blog-page
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --blog-columns: {{ columns }};
    --blog-card-corner-radius: {{ section.settings.corner_radius }}px;
  "
  data-testid="blog-posts"
>
  {% paginate blog.articles by posts_per_page %}
    {% liquid
      assign show_featured = false
      if section.settings.show_featured and paginate.current_page == 1 and current_tags == blank and blog.articles.size > 1
        assign show_featured = true
      endif
    %}

    <h1 class="visually-hidden">{{ blog.title | escape }}</h1>

    {%- if show_featured -%}
      <div class="blog-page__featured">
        {% render 'blog-card',
          article: blog.articles.first,
          variant: 'featured',
          heading_tag: 'h2',
          image_ratio: section.settings.image_ratio,
          image_sizes: '(min-width: 750px) 60vw, 100vw',
          image_loading: 'eager',
          image_fetch_priority: 'high',
          show_category: section.settings.show_category,
          show_date: section.settings.show_date,
          show_author: section.settings.show_author
        %}
      </div>
    {%- endif -%}

    <div class="blog-page__header">
      <p
        class="blog-page__title h2"
        aria-hidden="true"
      >
        {{ blog.title | escape }}
      </p>

      {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
        <nav
          class="blog-page__tags"
          aria-label="{{ 'blogs.article.filter_label' | t }}"
        >
          <ul
            class="blog-page__tag-list"
            role="list"
          >
            <li>
              <a
                href="{{ blog.url }}"
                class="blog-page__tag{% if current_tags == blank %} blog-page__tag--active{% endif %}"
                {% if current_tags == blank %}
                  aria-current="page"
                {% endif %}
              >
                {{- 'blogs.article.all_posts' | t -}}
              </a>
            </li>
            {%- for tag in blog.all_tags -%}
              {%- assign is_active = false -%}
              {%- if current_tags contains tag -%}
                {%- assign is_active = true -%}
              {%- endif -%}
              <li>
                <a
                  href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                  class="blog-page__tag{% if is_active %} blog-page__tag--active{% endif %}"
                  {% if is_active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- tag | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- if blog.articles.size > 0 -%}
      <ul
        class="blog-page__grid"
        role="list"
      >
        {%- for article in blog.articles -%}
          {%- if show_featured and forloop.first -%}
            {%- continue -%}
          {%- endif -%}
          {% liquid
            # Without a featured post, the first row is the top of the page and loads eagerly
            assign image_loading = 'lazy'
            assign image_fetch_priority = 'auto'
            if show_featured == false and forloop.index <= columns
              assign image_loading = 'eager'
              if forloop.first
                assign image_fetch_priority = 'high'
              endif
            endif
          %}
          <li class="blog-page__item">
            {% render 'blog-card',
              article: article,
              heading_tag: 'h3',
              image_ratio: section.settings.image_ratio,
              image_sizes: grid_sizes,
              image_loading: image_loading,
              image_fetch_priority: image_fetch_priority,
              show_category: section.settings.show_category,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_excerpt: section.settings.show_excerpt
            %}
          </li>
        {%- endfor -%}
      </ul>

      {% render 'pagination-controls', paginate: paginate %}
    {%- else -%}
      <p class="blog-page__empty">{{ 'blogs.article.no_posts' | t }}</p>
    {%- endif -%}
  {% endpaginate %}
</div>

{% stylesheet %}
  .blog-page {
    --blog-gap: clamp(20px, 2.5vw, 36px);
  }

  .blog-page__featured {
    padding-block-end: clamp(32px, 5vw, 64px);
    margin-block-end: clamp(32px, 5vw, 64px);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .blog-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 20px);
    margin-block-end: clamp(24px, 3vw, 40px);
  }

  .blog-page__title {
    margin: 0;
  }

  .blog-page__tag-list {
    display: flex;
    gap: var(--gap-xs, 8px);
    margin: 0;
    padding: 0;
    list-style: none;

    /* Phones scroll the tags sideways instead of wrapping into many rows */
    @media screen and (max-width: 749px) {
      margin-inline: calc(-1 * var(--page-margin, 16px));
      padding-inline: var(--page-margin, 16px);
      overflow-x: auto;
      scrollbar-width: none;
    }

    @media screen and (min-width: 750px) {
      flex-wrap: wrap;
    }
  }

  .blog-page__tag-list::-webkit-scrollbar {
    display: none;
  }

  .blog-page__tag {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: 18px;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: 999px;
    color: var(--color-foreground);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--animation-speed) var(--animation-easing),
      border-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);
  }

  .blog-page__tag:hover {
    border-color: var(--color-foreground);
  }

  .blog-page__tag--active {
    border-color: var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(36px, 4vw, 56px) var(--blog-gap);
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--blog-columns), minmax(0, 1fr));
    }
  }

  .blog-page .pagination {
    margin-block-start: clamp(40px, 5vw, 64px);
  }

  .blog-page__empty {
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "t:settings.blog_show_featured",
      "info": "t:info.blog_show_featured",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:settings.blog_show_tags",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:settings.blog_posts_per_page",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:options.landscape"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "adapt",
          "label": "t:options.auto"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:settings.blog_show_category",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:settings.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:settings.show_author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:settings.blog_show_excerpt",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
