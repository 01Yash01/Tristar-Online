{% comment %}
  Section contract.
  A row of pill links (round image or icon, label) for jumping to key collections or pages.
  Pills are centered when they fit and scroll sideways when they do not; desktop adds arrows.
  Without JavaScript the row is still a plain, scrollable list of links.
  With Links set to related collections, a collection page shows the collections around the
  current one in the chosen menu instead of the blocks, and the section hides when there are none.
  @example
  <!-- Add section > Quick links, then pick a collection for each pill -->
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  # Related mode: a menu item for this collection that has sub-items gives those sub-items;
  # otherwise the collections beside it under the same parent are used
  assign show_related = false
  assign related_parent = nil
  assign related_count = 0

  if section.settings.link_source == 'related'
    assign show_related = true
    assign related_menu = section.settings.related_menu

    if collection != blank and related_menu != blank
      for l1 in related_menu.links
        if l1.type == 'collection_link' and l1.object.id == collection.id and l1.links.size > 0
          assign related_parent = l1
          break
        endif
        for l2 in l1.links
          if l2.type == 'collection_link' and l2.object.id == collection.id and l2.links.size > 0
            assign related_parent = l2
            break
          endif
        endfor
        if related_parent != nil
          break
        endif
      endfor

      if related_parent == nil
        for l1 in related_menu.links
          for l2 in l1.links
            if l2.type == 'collection_link' and l2.object.id == collection.id
              assign related_parent = l1
              break
            endif
            for l3 in l2.links
              if l3.type == 'collection_link' and l3.object.id == collection.id
                assign related_parent = l2
                break
              endif
            endfor
            if related_parent != nil
              break
            endif
          endfor
          if related_parent != nil
            break
          endif
        endfor
      endif

      if related_parent != nil
        for link in related_parent.links
          if link.type == 'collection_link' and link.object.id != collection.id
            assign related_count = related_count | plus: 1
          endif
        endfor
      endif
    endif
  endif

  assign media_size = section.settings.image_size | default: 48
  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif

  # Shiny edge: the glint's brightest point, the resting rim, the shadow and the picture backdrop
  # follow the pill's brightness, so light and dark pills both keep a visible glint and outline
  assign is_shiny = false
  if section.settings.style == 'shiny'
    assign is_shiny = true
    assign shiny_fill = section.settings.shiny_pill_color | default: '#ffffff'
    assign shiny_label = section.settings.shiny_label_color | default: '#0b1f44'
    assign shiny_glint = section.settings.shiny_glint_color | default: '#d4a73c'
    assign shiny_glint_soft = shiny_glint | color_lighten: 12
    assign shiny_fill_brightness = shiny_fill | color_brightness
    if shiny_fill_brightness > 160
      assign shiny_shine = shiny_glint | color_darken: 15
      assign shiny_ink = shiny_label
      assign shiny_edge = shiny_label | color_modify: 'alpha', 0.14
      assign shiny_shadow = shiny_label | color_modify: 'alpha', 0.08
      assign shiny_shadow_far = shiny_label | color_modify: 'alpha', 0.4
      assign shiny_media = shiny_fill | color_darken: 4
      assign shiny_sheen_rest = 0
      assign shiny_sheen_hover = 0.22
      assign shiny_glow = 0.55
    else
      assign shiny_shine = shiny_glint | color_mix: '#ffffff', 25
      assign shiny_ink = shiny_fill
      assign shiny_edge = shiny_fill
      assign shiny_shadow = shiny_fill | color_modify: 'alpha', 0.18
      assign shiny_shadow_far = shiny_fill | color_modify: 'alpha', 0.6
      assign shiny_media = '#ffffff'
      assign shiny_sheen_rest = 0.16
      assign shiny_sheen_hover = 0.5
      assign shiny_glow = 1
    endif
  endif
%}

{%- if show_related and related_count == 0 -%}
  {%- comment -%} Nothing related to this collection in the menu, so the section stays out of the page {%- endcomment -%}
{%- else -%}
<script
  src="{{ 'quick-links.js' | asset_url }}"
  type="module"
></script>

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <quick-links
    class="quick-links quick-links--{{ section.settings.style }} quick-links--align-{{ section.settings.alignment }}{% if is_shiny %} quick-links--glint-{{ section.settings.shiny_glint_motion | default: 'always' }}{% else %} quick-links--hover-{{ section.settings.hover_effect | default: 'fill' }}{% endif %}"
    style="
      --quick-links-gap: {{ section.settings.gap }}px;
      --quick-link-media-size: {{ section.settings.image_size }}px;
      --quick-link-hover-background: {{ section.settings.hover_background_color | default: 'var(--color-foreground)' }};
      --quick-link-hover-text: {{ section.settings.hover_text_color | default: 'var(--color-background)' }};
      {%- if is_shiny %}
        --quick-link-shiny-fill: {{ shiny_fill }};
        --quick-link-shiny-label: {{ shiny_label }};
        --quick-link-shiny-glint: {{ shiny_glint }};
        --quick-link-shiny-glint-soft: {{ shiny_glint_soft }};
        --quick-link-shiny-shine: {{ shiny_shine }};
        --quick-link-shiny-ink: {{ shiny_ink }};
        --quick-link-shiny-edge: {{ shiny_edge }};
        --quick-link-shiny-shadow: {{ shiny_shadow }};
        --quick-link-shiny-shadow-far: {{ shiny_shadow_far }};
        --quick-link-shiny-media: {{ shiny_media }};
        --quick-link-shiny-sheen-rest: {{ shiny_sheen_rest }};
        --quick-link-shiny-sheen-hover: {{ shiny_sheen_hover }};
        --quick-link-shiny-glow: {{ shiny_glow }};
      {%- endif %}
    "
    {% if settings.reveal_on_scroll %}
      data-reveal
    {% endif %}
  >
    <nav aria-label="{{ 'content.quick_links' | t }}">
      <scroll-hint
        class="quick-links__scroller"
        ref="scroller"
      >
        <ul
          class="quick-links__list"
          role="list"
        >
          {%- if show_related -%}
            {%- assign related_rendered = 0 -%}
            {%- for link in related_parent.links -%}
              {%- if link.type != 'collection_link' or link.object.id == collection.id -%}
                {%- continue -%}
              {%- endif -%}
              {%- liquid
                assign related_image = link.object.featured_image
                if related_image == blank
                  assign related_image = link.object.products.first.featured_image
                endif
              -%}
              {%- render 'quick-link-pill',
                label: link.title,
                url: link.url,
                image: related_image,
                is_active: link.current,
                show_arrow_icon: section.settings.show_arrow_icon,
                media_size: media_size,
                image_loading: image_loading
              -%}
              {%- assign related_rendered = related_rendered | plus: 1 -%}
              {%- if related_rendered >= 12 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {% content_for 'blocks' %}
          {%- endif -%}
        </ul>
      </scroll-hint>
    </nav>

    {%- if section.settings.show_arrows -%}
      <button
        type="button"
        class="quick-links__arrow quick-links__arrow--previous"
        ref="previous"
        on:click="/previous"
        aria-label="{{ 'accessibility.slideshow_previous' | t }}"
        disabled
      >
        <span
          class="svg-wrapper"
          aria-hidden="true"
        >
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </button>
      <button
        type="button"
        class="quick-links__arrow quick-links__arrow--next"
        ref="next"
        on:click="/next"
        aria-label="{{ 'accessibility.slideshow_next' | t }}"
        disabled
      >
        <span
          class="svg-wrapper"
          aria-hidden="true"
        >
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </button>
    {%- endif -%}
  </quick-links>
</div>
{%- endif -%}

{% stylesheet %}
  .quick-links {
    --quick-link-height: calc(var(--quick-link-media-size) + 16px);
    --quick-link-border: rgb(var(--color-foreground-rgb) / var(--opacity-15));

    display: block;
    position: relative;
    min-width: 0;
  }

  /* Block element until scroll-hint is defined, so the row lays out without JavaScript too */
  .quick-links__scroller {
    display: block;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;

    /* Room for focus rings, which the scroller would otherwise clip */
    padding-block: 4px;
  }

  .quick-links__scroller::-webkit-scrollbar {
    display: none;
  }

  /* max-content + auto margins: centered while the pills fit, scrolling from the start once they don't */
  .quick-links__list {
    display: flex;
    gap: var(--quick-links-gap);
    width: max-content;
    margin: 0;
    padding: 0 4px;
    list-style: none;
  }

  .quick-links--align-center .quick-links__list {
    margin-inline: auto;
  }

  .quick-links__item {
    flex: 0 0 auto;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--quick-link-height);
    padding-block: 8px;

    padding-inline: 8px 20px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-radius: 999px;

    /* An inset shadow draws the outline, so the hover fill reaches the pill's edge with no border
       in between (a real border leaves light slivers where the rounded ends are anti-aliased). */
    box-shadow: inset 0 0 0 1px var(--quick-link-border);
    color: var(--color-foreground);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: box-shadow var(--animation-speed) var(--animation-easing),
      background-color var(--animation-speed) var(--animation-easing),
      color 0.45s ease;
  }

  /* Hover fill: sweeps left to right behind the content, like the theme's arrow buttons.
     A plain rectangle clipped by the pill keeps its edges exactly on the pill's curve. */
  .quick-link::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: -1;
    width: 0;
    background-color: var(--quick-link-hover-background);
    pointer-events: none;
    transition: width 0.55s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* With the hover arrow, its space is always reserved, so the end padding is smaller */
  .quick-link:has(.quick-link__arrow) {
    padding-inline-end: 8px;
  }

  .quick-link:not(:has(.quick-link__media)) {
    padding-inline-start: 20px;
  }

  .quick-links--fill .quick-link {
    box-shadow: none;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .quick-link__media {
    display: flex;
    flex: 0 0 var(--quick-link-media-size);
    align-items: center;
    justify-content: center;
    width: var(--quick-link-media-size);
    height: var(--quick-link-media-size);
    overflow: hidden;
    border-radius: 50%;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .quick-link__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out-cubic);
  }

  .quick-link__icon {
    width: 50%;
    height: 50%;
  }

  /* Hover: border firms up, the image eases in, and an arrow slides in after the label.
     The arrow's space is always reserved, so pills never change size and neighbours never shift. */
  .quick-link__arrow {
    display: flex;
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    margin-inline-start: -4px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s ease, transform 0.4s var(--ease-out-cubic);
  }

  .quick-link__arrow svg {
    width: 14px;
    height: 14px;
  }

  [dir='rtl'] .quick-link__arrow {
    transform: translateX(4px) scaleX(-1);
  }

  @media (hover: hover) {
    .quick-link:hover {
      box-shadow: inset 0 0 0 1px var(--color-foreground);
    }

    .quick-links--hover-fill .quick-link:hover {
      box-shadow: inset 0 0 0 1px var(--quick-link-hover-background);
      color: var(--quick-link-hover-text);
    }

    .quick-links--hover-fill .quick-link:hover::before {
      width: 100%;
    }

    .quick-link:hover .quick-link__image {
      transform: scale(1.1);
    }

    .quick-link:hover .quick-link__arrow {
      opacity: 1;
      transform: none;
    }

    [dir='rtl'] .quick-link:hover .quick-link__arrow {
      transform: scaleX(-1);
    }
  }

  .quick-link:focus-visible {
    outline: var(--focus-outline-width, 2px) solid currentColor;
    outline-offset: 2px;
  }

  /* The pill for the page being viewed */
  .quick-link--active,
  .quick-links--fill .quick-link--active {
    box-shadow: none;
    background-color: var(--quick-link-hover-background);
    color: var(--quick-link-hover-text);
  }

  /* Desktop arrows appear only while the row overflows (set by assets/quick-links.js) */
  .quick-links__arrow {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .quick-links[data-overflowing] .quick-links__arrow {
      position: absolute;
      inset-block-start: 50%;
      z-index: var(--layer-raised);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 1px solid var(--quick-link-border);
      border-radius: 50%;
      background-color: var(--color-background);
      color: var(--color-foreground);
      box-shadow: 0 4px 16px rgb(0 0 0 / 0.1);
      cursor: pointer;
      transform: translateY(-50%);
      transition: opacity var(--animation-speed) var(--animation-easing);
    }

    /* Inside the row's faded edges, so they stay on screen for full-width sections too */
    .quick-links__arrow--previous {
      inset-inline-start: 4px;
    }

    .quick-links__arrow--next {
      inset-inline-end: 4px;
    }

    .quick-links[data-overflowing] .quick-links__arrow:disabled {
      opacity: 0;
      pointer-events: none;
    }

    .quick-links__arrow .svg-wrapper {
      display: flex;
      width: 16px;
      height: 16px;
    }

    .quick-links__arrow--previous .svg-wrapper,
    [dir='rtl'] .quick-links__arrow--next .svg-wrapper {
      transform: scaleX(-1);
    }

    [dir='rtl'] .quick-links__arrow--previous .svg-wrapper {
      transform: none;
    }
  }

  /* Shiny edge: a glint travels round each pill's rim, starting at a different point on each pill.
     Hover or focus widens and softens it, adds a sheen and a glow from below, and slows it down.
     Colors come from the section settings, through the custom properties set on quick-links. */
  @property --quick-link-glint-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @property --quick-link-glint-offset {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @property --quick-link-glint-arc {
    syntax: '<percentage>';
    initial-value: 5%;
    inherits: false;
  }

  @property --quick-link-glint-shine {
    syntax: '<color>';
    initial-value: #fff;
    inherits: false;
  }

  .quick-links--shiny {
    --quick-link-glint-speed: 4s;
    --quick-link-shiny-border: 1px;
  }

  .quick-links--shiny .quick-links__item:nth-child(3n + 2) {
    --quick-link-glint-delay: -1.4s;
  }

  .quick-links--shiny .quick-links__item:nth-child(3n + 3) {
    --quick-link-glint-delay: -2.7s;
  }

  /* The rim is a transparent border showing a turning conic gradient over a faint resting edge;
     the padding gives back the border's width so the pill keeps its size */
  .quick-links--shiny .quick-link {
    --quick-link-glint-shine: var(--quick-link-shiny-shine);

    padding-block: calc(8px - var(--quick-link-shiny-border));
    padding-inline: calc(8px - var(--quick-link-shiny-border)) calc(20px - var(--quick-link-shiny-border));
    border: var(--quick-link-shiny-border) solid transparent;
    background:
      linear-gradient(var(--quick-link-shiny-fill), var(--quick-link-shiny-fill)) padding-box,
      conic-gradient(
          from calc(var(--quick-link-glint-angle) - var(--quick-link-glint-offset)),
          transparent,
          var(--quick-link-shiny-glint) var(--quick-link-glint-arc),
          var(--quick-link-glint-shine) calc(var(--quick-link-glint-arc) * 2),
          var(--quick-link-shiny-glint) calc(var(--quick-link-glint-arc) * 3),
          transparent calc(var(--quick-link-glint-arc) * 4)
        )
        border-box,
      linear-gradient(var(--quick-link-shiny-edge), var(--quick-link-shiny-edge)) border-box;
    box-shadow: 0 1px 1px var(--quick-link-shiny-shadow), 0 10px 20px -14px var(--quick-link-shiny-shadow-far);
    color: var(--quick-link-shiny-label);
    transition: --quick-link-glint-arc 0.8s cubic-bezier(0.25, 1, 0.5, 1),
      --quick-link-glint-offset 0.8s cubic-bezier(0.25, 1, 0.5, 1),
      --quick-link-glint-shine 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    animation: quick-link-glint var(--quick-link-glint-speed) linear infinite,
      quick-link-glint calc(var(--quick-link-glint-speed) / 0.4) linear infinite reverse paused;
    animation-composition: add;
    animation-delay: var(--quick-link-glint-delay, 0s), var(--quick-link-glint-delay, 0s);
  }

  .quick-links--shiny .quick-link:has(.quick-link__arrow) {
    padding-inline-end: calc(8px - var(--quick-link-shiny-border));
  }

  .quick-links--shiny .quick-link:not(:has(.quick-link__media)) {
    padding-inline-start: calc(20px - var(--quick-link-shiny-border));
  }

  /* This style has no fill sweep */
  .quick-links--shiny .quick-link::before {
    display: none;
  }

  /* Sheen: a soft band of the glint color turning slowly inside the pill */
  .quick-links--shiny .quick-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    z-index: -1;
    aspect-ratio: 1;
    background: linear-gradient(-50deg, transparent, var(--quick-link-shiny-glint), transparent);
    opacity: var(--quick-link-shiny-sheen-rest);
    pointer-events: none;
    translate: 0 -50%;
    mask-image: radial-gradient(circle at bottom, transparent 40%, #000);
    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    animation: quick-link-sheen var(--quick-link-glint-speed) linear infinite,
      quick-link-sheen calc(var(--quick-link-glint-speed) / 0.4) linear infinite reverse paused;
    animation-composition: add;
    animation-delay: var(--quick-link-glint-delay, 0s), var(--quick-link-glint-delay, 0s);
  }

  /* Glow: rises from the bottom of the pill on hover (the label is unpositioned, so this fills the pill) */
  .quick-links--shiny .quick-link__label::before {
    content: '';
    position: absolute;
    inset: -0.5rem;
    z-index: -1;
    box-shadow: inset 0 -1ex 2rem 4px var(--quick-link-shiny-glint);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    animation: quick-link-breathe calc(var(--quick-link-glint-speed) * 1.5) linear infinite paused;
  }

  .quick-links--shiny .quick-link__media {
    background-color: var(--quick-link-shiny-media);
  }

  .quick-links--shiny .quick-link:is(:hover, :focus-visible) {
    --quick-link-glint-arc: 20%;
    --quick-link-glint-offset: 95deg;
    --quick-link-glint-shine: var(--quick-link-shiny-glint-soft);

    box-shadow: 0 1px 1px var(--quick-link-shiny-shadow), 0 10px 20px -14px var(--quick-link-shiny-shadow-far);
  }

  .quick-links--shiny .quick-link:is(:hover, :focus-visible),
  .quick-links--shiny .quick-link:is(:hover, :focus-visible)::after {
    animation-play-state: running, running;
  }

  .quick-links--shiny .quick-link:is(:hover, :focus-visible)::after {
    opacity: var(--quick-link-shiny-sheen-hover);
  }

  .quick-links--shiny .quick-link:is(:hover, :focus-visible) .quick-link__label::before {
    opacity: var(--quick-link-shiny-glow);
    animation-play-state: running;
  }

  .quick-links--shiny .quick-link:focus-visible {
    outline-color: var(--quick-link-shiny-ink);
  }

  /* Only on hover: each glint rests where it is until its pill is pointed at or focused.
     data-offscreen (set by assets/quick-links.js) rests every glint while the row is out of view. */
  .quick-links--glint-hover .quick-link:not(:hover, :focus-visible),
  .quick-links--glint-hover .quick-link:not(:hover, :focus-visible)::after,
  .quick-links--shiny[data-offscreen] .quick-link,
  .quick-links--shiny[data-offscreen] .quick-link::after {
    animation-play-state: paused, paused;
  }

  /* The pill for the page being viewed keeps a steady rim in the glint color */
  .quick-links--shiny .quick-link--active {
    background:
      linear-gradient(var(--quick-link-shiny-fill), var(--quick-link-shiny-fill)) padding-box,
      linear-gradient(var(--quick-link-shiny-glint), var(--quick-link-shiny-glint)) border-box;
    color: var(--quick-link-shiny-label);
    animation: none;
  }

  @keyframes quick-link-glint {
    to {
      --quick-link-glint-angle: 360deg;
    }
  }

  @keyframes quick-link-sheen {
    to {
      rotate: 360deg;
    }
  }

  @keyframes quick-link-breathe {
    0%,
    100% {
      scale: 1;
    }

    50% {
      scale: 1.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-link,
    .quick-link::before,
    .quick-link__image,
    .quick-link__arrow {
      transition: none;
    }

    .quick-links--shiny .quick-link,
    .quick-links--shiny .quick-link::after,
    .quick-links--shiny .quick-link__label::before {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quick_links",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_quick-link"
    }
  ],
  "max_blocks": 24,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "link_source",
      "label": "t:settings.links",
      "info": "t:info.quick_links_source",
      "options": [
        {
          "value": "blocks",
          "label": "t:options.quick_links_source_blocks"
        },
        {
          "value": "related",
          "label": "t:options.quick_links_source_related"
        }
      ],
      "default": "blocks"
    },
    {
      "type": "link_list",
      "id": "related_menu",
      "label": "t:settings.menu",
