

{% liquid
  assign max_items = section.settings.max_products

  # Optional side banner: without an image the section is the standard product list
  assign banner_image = section.settings.banner_image
  assign banner_loading = 'lazy'
  if section.index <= 2
    assign banner_loading = 'eager'
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- if banner_image != blank -%}
    {%- liquid
      assign banner_settings = section.settings
      assign banner_mobile_image = banner_settings.banner_mobile_image
      assign banner_link_label = banner_image.alt | default: banner_settings.collection.title
      if banner_link_label == blank
        assign banner_link_label = 'accessibility.view_link' | t
      endif
    -%}
    <div
      class="product-list-banner product-list-banner--{{ banner_settings.banner_position }} product-list-banner--fit-{{ banner_settings.banner_fit }}{% unless banner_settings.banner_mobile %} product-list-banner--hide-mobile{% endunless %}{% if banner_settings.banner_zoom and banner_settings.banner_link != blank %} product-list-banner--zoom{% endif %}"
      style="
        --product-list-banner-width: {{ banner_settings.banner_width }}%;
        --product-list-banner-radius: {{ banner_settings.banner_radius }}px;
        --product-list-banner-padding: {{ banner_settings.banner_padding }}px;
        --product-list-banner-ratio: {{ banner_image.aspect_ratio | default: 1 }};
        --product-list-banner-ratio-mobile: {{ banner_mobile_image.aspect_ratio | default: banner_image.aspect_ratio | default: 1 }};
        {% if banner_settings.banner_background != blank %}--product-list-banner-background: {{ banner_settings.banner_background }};{% endif %}
        {% if banner_settings.banner_border %}--product-list-banner-border-color: {{ banner_settings.banner_border_color | default: 'rgb(var(--color-foreground-rgb) / var(--opacity-10))' }};{% endif %}
      "
      {% if settings.reveal_on_scroll %}
        data-reveal
      {% endif %}
    >
      <div class="product-list-banner__media{% if banner_settings.banner_border %} product-list-banner__media--border{% endif %}">
        <div class="product-list-banner__frame">
          <picture>
            {%- if banner_mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ banner_mobile_image | image_url: width: 400 }} 400w, {{ banner_mobile_image | image_url: width: 600 }} 600w, {{ banner_mobile_image | image_url: width: 800 }} 800w, {{ banner_mobile_image | image_url: width: 1100 }} 1100w"
                sizes="100vw"
                width="{{ banner_mobile_image.width }}"
                height="{{ banner_mobile_image.height }}"
              >
            {%- endif -%}
            {{
              banner_image
              | image_url: width: 1200
              | image_tag:
                widths: '360, 480, 640, 800, 1000, 1200',
                sizes: '(min-width: 750px) 40vw, 100vw',
                loading: banner_loading,
                class: 'product-list-banner__image'
            }}
          </picture>
        </div>

        {%- if banner_settings.banner_link != blank -%}
          <a
            href="{{ banner_settings.banner_link }}"
            class="product-list-banner__link"
            aria-label="{{ banner_link_label | escape }}"
          ></a>
        {%- endif -%}

        <div class="product-list-banner__content">
          {% content_for 'block', type: 'group', id: 'banner-content' %}
        </div>
      </div>

      <div class="product-list-banner__products">
  {%- endif -%}

  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'collection'
            %}
          </div>

          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>

  {%- if banner_image != blank -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /*
   * Side banner: an image beside the products. Without a banner image none of this markup renders.
   * Desktop: two columns, the image filling the banner's full height. Mobile: the image above the
   * products at its natural shape, or hidden.
   */
  .product-list-banner {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    min-width: 0;
  }

  /* The banner card: optional background, border, and inner padding around the image frame */
  .product-list-banner__media {
    position: relative;
    overflow: hidden;
    padding: var(--product-list-banner-padding);
    border-radius: var(--product-list-banner-radius);
    background-color: var(--product-list-banner-background, transparent);
  }

  .product-list-banner__media--border {
    box-shadow: inset 0 0 0 1px var(--product-list-banner-border-color);
  }

  .product-list-banner__frame {
    position: relative;
    overflow: hidden;
    border-radius: max(0px, calc(var(--product-list-banner-radius) - var(--product-list-banner-padding)));
    aspect-ratio: var(--product-list-banner-ratio-mobile);
  }

  .product-list-banner__frame picture {
    display: contents;
  }

  .product-list-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-cubic);
  }

  .product-list-banner--fit-contain .product-list-banner__image {
    object-fit: contain;
  }

  /* Whole-banner link sits under the content; only the content's own links and buttons take clicks */
  .product-list-banner__link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .product-list-banner__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    pointer-events: none;
  }

  /* The banner content group fills the banner, so its own alignment and padding place the text */
  .product-list-banner__content > .group-block {
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
  }

  .product-list-banner__content :is(a, button, input, select, textarea) {
    pointer-events: auto;
  }

  .shopify-design-mode .product-list-banner__content * {
    pointer-events: auto;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .product-list-banner--zoom .product-list-banner__media:has(.product-list-banner__link:hover) .product-list-banner__image {
      transform: scale(1.03);
    }
  }

  /* The products column is narrower than the page, so carousels use no page-margin gutters inside it */
  .product-list-banner__products {
    --util-page-margin-offset: 0px;

    display: flex;
    flex-direction: column;
    gap: var(--gap);
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .product-list-banner--hide-mobile .product-list-banner__media {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .product-list-banner {
      display: grid;
      grid-template-columns: var(--product-list-banner-width) minmax(0, 1fr);
      align-items: stretch;
    }

    .product-list-banner--right {
      grid-template-columns: minmax(0, 1fr) var(--product-list-banner-width);
    }

    .product-list-banner--right .product-list-banner__media {
      order: 2;
    }

    /* Stretches to the products column's height; the floor keeps short rows from squashing it.
       The frame fills the card inside its padding. */
    .product-list-banner__media {
      min-height: 320px;
    }

    .product-list-banner__frame {
      position: absolute;
      inset: var(--product-list-banner-padding);
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.product_list_banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "t:settings.image",
      "info": "t:info.product_list_banner_image"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "t:settings.link",
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "select",
      "id": "banner_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "range",
      "id": "banner_width",
      "label": "t:settings.product_list_banner_width",
      "min": 20,
      "max": 45,
      "step": 1,
      "unit": "%",
      "default": 28,
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "banner_mobile",
      "label": "t:settings.product_list_banner_mobile",
      "default": true,
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "image_picker",
      "id": "banner_mobile_image",
      "label": "t:settings.product_list_banner_mobile_image",
      "info": "t:info.product_list_banner_mobile_image",
      "visible_if": "{{ section.settings.banner_image != blank and section.settings.banner_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "banner_zoom",
      "label": "t:settings.product_list_banner_zoom",
      "default": true,
      "visible_if": "{{ section.settings.banner_image != blank and section.settings.banner_link != blank }}"
    },
    {
      "type": "select",
      "id": "banner_fit",
      "label": "t:settings.media_fit",
      "info": "t:info.product_list_banner_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "range",
      "id": "banner_padding",
      "label": "t:settings.product_list_banner_padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "color",
      "id": "banner_background",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "banner_border",
      "label": "t:settings.product_list_banner_border",
      "default": false,
      "visible_if": "{{ section.settings.banner_image != blank }}"
    },
    {
      "type": "color",
      "id": "banner_border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.banner_image != blank and section.settings.banner_border }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.products_with_banner",
      "category": "t:categories.products",
      "settings": {
        "collection": "",
        "max_products": 8,
        "layout_type": "carousel",
        "carousel_on_mobile": false,
        "columns": 3,
        "mobile_columns": "2",
        "columns_gap": 12,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48,
        "banner_position": "left",
        "banner_width": 28,
        "banner_mobile": true,
        "banner_zoom": true,
        "banner_fit": "cover",
        "banner_padding": 0,
        "banner_radius": 12,
        "banner_border": false
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "name": "t:names.collection_title",
              "settings": {
                "text": "<h2>{{ closest.collection.title }}</h2>",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_list_button": {
              "type": "_product-list-button",
              "name": "t:names.product_list_button",
              "settings": {
                "label": "t:text_defaults.view_all_button_label",
                "open_in_new_tab": false,
                "style_class": "button-unstyled",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              }
            }
          },
          "block_order": [
            "product_list_text",
            "product_list_button"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 6,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 12,
            "padding-block-start": 12,
            "padding-block-end": 16,
            "padding-inline-start": 12,
            "padding-inline-end": 12,
            "background_color": "#FFFFFF"
          },
          "blocks": {
            "product-card-gallery": {
