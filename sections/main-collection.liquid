

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {%- liquid
        assign products_per_page = 24

        if section.settings.enable_infinite_scroll == false
          assign products_per_page = section.settings.products_per_page
        endif

        # Shopify counts sold out products too. A collection that fits on one page is counted again from
        # the products that remain; a longer one keeps Shopify's count, which can run a little high.
        assign results_size = collection.products_count
        if settings.hide_sold_out_products and results_size <= products_per_page
          assign results_size = collection.products | where: 'available' | size
        endif

        # A collection with nothing to buy, and no filters picked, gets the friendly empty state in place
        # of the filter bar. Filters that match nothing keep the plain "use fewer filters" message.
        assign filters_applied = false
        for filter in collection.filters
          case filter.type
            when 'price_range'
              if filter.min_value.value != null or filter.max_value.value != null
                assign filters_applied = true
              endif
            when 'boolean'
              if filter.active_values[0].value
                assign filters_applied = true
              endif
            else
              if filter.active_values.size > 0
                assign filters_applied = true
              endif
          endcase
        endfor
        assign show_empty_state = false
        if results_size == 0 and filters_applied == false
          assign show_empty_state = true
        endif
      -%}

      {% unless show_empty_state %}
        {% content_for 'block',
          type: 'filters',
          id: 'filters',
          results: collection,
          results_size: results_size
        %}
      {% endunless %}

      {% paginate collection.products by products_per_page %}
        {%- liquid
          # Sold out products are left out when Theme settings > Product cards hides them. Otherwise they
          # follow the ones shoppers can buy, each group in the collection's own order, and
          # paginated-list.js keeps that order as more pages load.
          assign available_products = collection.products | where: 'available'
          assign cards_limit = 50
          if show_empty_state
            # Nothing to buy here, so a few products from another collection go under the message
            assign picks_source = section.settings.empty_picks_collection | default: settings.empty_state_collection | default: collections.all
            assign ordered_products = picks_source.products | where: 'available'
            assign cards_limit = 4
          elsif settings.hide_sold_out_products
            assign ordered_products = available_products
          else
            assign sold_out_products = collection.products | reject: 'available'
            assign ordered_products = available_products | concat: sold_out_products
          endif

          # A page with nothing left still renders its grid when more pages exist, so paginated-list.js
          # carries on to them. Only a collection with nothing to show at all gets the empty message.
          assign grid_products = collection.products
          if show_empty_state
            assign grid_products = available_products
          elsif settings.hide_sold_out_products and ordered_products.size == 0 and paginate.pages == 1
            assign grid_products = ordered_products
          endif
        -%}
        {% capture children %}
          {% for product in ordered_products limit: cards_limit %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              {% unless product.available %}
                data-sold-out
              {% endunless %}
              {% unless show_empty_state %}
                ref="cards[]"
              {% endunless %}
            >
              {% content_for 'block',
                type: '_product-card',
                id: 'product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: grid_products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll,
          empty_state: show_empty_state,
          empty_picks: children
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.empty_collection"
    },
    {
      "type": "paragraph",
      "content": "t:content.empty_collection_help"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "t:settings.text"
    },
    {
      "type": "color",
      "id": "empty_art_color",
      "label": "t:settings.empty_collection_art_color",
      "info": "t:info.empty_collection_art_color"
    },
    {
      "type": "text",
      "id": "empty_link_1_label",
      "label": "t:settings.empty_link_label_1"
    },
    {
      "type": "url",
      "id": "empty_link_1_url",
      "label": "t:settings.empty_link_url_1"
    },
    {
      "type": "text",
      "id": "empty_link_2_label",
      "label": "t:settings.empty_link_label_2"
    },
    {
      "type": "url",
      "id": "empty_link_2_url",
      "label": "t:settings.empty_link_url_2"
    },
    {
      "type": "text",
      "id": "empty_link_3_label",
      "label": "t:settings.empty_link_label_3"
    },
    {
      "type": "url",
      "id": "empty_link_3_url",
      "label": "t:settings.empty_link_url_3"
    },
    {
      "type": "collection",
      "id": "empty_picks_collection",
      "label": "t:settings.empty_collection_suggestions",
      "info": "t:info.empty_collection_suggestions"
    }
  ],
  "presets": []
}
{% endschema %}
