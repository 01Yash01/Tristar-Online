            "gap": 12,
            "drawer_finish": "aluminium",
            "drawer_font": "typewriter",
            "drawer_label": "Tristar · FAQ",
            "drawer_note": "Not in the drawer? Ask us and a real person will reply.",
            "drawer_button_label": "Ask us",
            "drawer_button_link": "shopify://pages/contact",
            "type_preset": "h5",
            "background_color": "",
            "text_color": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "row_1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is shipping really free?",
                "tab_label": "Shipping",
                "open_by_default": true,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Standard shipping is free on every order delivered within Australia, with no minimum spend. Express shipping and delivery to New Zealand are calculated at checkout.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "show_on_mobile": true,
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "font_size_mobile": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How long will my order take to arrive?",
                "tab_label": "Delivery",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We dispatch orders within 1–2 business days. Standard delivery within Australia then takes 3–7 business days, or 2–3 business days with Express. Delivery to New Zealand takes 14–16 business days (standard) or 8–10 business days (Express). Please allow a little extra time during peak periods.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "show_on_mobile": true,
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "font_size_mobile": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I track my order?",
                "tab_label": "Tracking",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>As soon as your order ships, we'll email you a tracking number. You can also sign in to your account to check your order status at any time. We ship with Australia Post, DHL Express and Hunter Express, and every shipment is insured.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "show_on_mobile": true,
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "font_size_mobile": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is your return policy?",
                "tab_label": "Returns",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Changed your mind? You can start a return within 14 days of delivery. Items must be unused and in their original packaging with all tags attached. Return shipping is at your cost and a 20% restocking fee applies, which may vary with the item's condition. Items marked as non-returnable on the product page can't be returned.</p><p>Refunds are processed within 48 hours of us receiving your return, or you can choose an exchange or store credit instead.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "show_on_mobile": true,
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "font_size_mobile": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_5": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What if my item arrives faulty or damaged?",
                "tab_label": "Damage",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Let us know within 48 hours of delivery and we'll make it right. Contact us through live chat or our contact page with your order number. Under warranty we'll repair the item first, then replace it, or refund it if neither is possible.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "show_on_mobile": true,
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "font_size_mobile": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_6": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do your products come with a warranty?",
                "tab_label": "Warranty",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Every product we sell, new or refurbished, comes with a 12-month warranty. Keep your proof of purchase and contact us to make a claim. Most claims are resolved within 2–5 days. The warranty doesn't cover physical, water or electrical damage, or damage from improper use. It's in addition to your rights under the Australian Consumer Law.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "show_on_mobile": true,
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "font_size_mobile": "",
                    "line_height": "normal",
