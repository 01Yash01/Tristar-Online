{%- doc -%}
  Small page startup helpers, rendered once in the layout head.
  - Opens linked pages ahead of the click, so moving between pages feels instant.
  - Starts the support chat widget once the shopper first interacts, or a few seconds after the
    page has loaded, so the widget does not compete with the first screen.

  @example
  {% render 'site-helpers' %}
{%- enddoc -%}

{%- liquid
  assign chat_src = 'https://supportcsops.com/chat/widget.js'
  assign chat_channel = 'tristaronline.com.au'
  assign chat_title = 'Tristar Online'
  assign chat_color = '#0f766e'
  # Seconds to wait after the page loads before the chat starts on its own
  assign chat_fallback_seconds = 5
-%}

{%- unless request.design_mode -%}
  <script type="speculationrules">
    {
      "prefetch": [
        {
          "where": {
            "and": [
              { "href_matches": "/*" },
              {
                "not": {
                  "href_matches": ["/cart*", "/checkout*", "/account*", "/orders*", "/*logout*", "/*?*add*"]
                }
              },
              { "not": { "selector_matches": "[rel~=nofollow], [download]" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
  </script>
{%- endunless -%}

<link rel="dns-prefetch" href="https://supportcsops.com">

<script>
  (function () {
    var started = false;
    var events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];

    function startChat() {
      if (started || !document.body) return;
      started = true;
      events.forEach(function (name) {
        window.removeEventListener(name, startChat);
      });

      var script = document.createElement('script');
      script.src = {{ chat_src | json }};
      script.async = true;
      script.setAttribute('data-channel', {{ chat_channel | json }});
      script.setAttribute('data-title', {{ chat_title | json }});
      script.setAttribute('data-color', {{ chat_color | json }});
      document.body.appendChild(script);
    }

    events.forEach(function (name) {
      window.addEventListener(name, startChat, { passive: true });
    });

    window.addEventListener('load', function () {
      setTimeout(function () {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(startChat, { timeout: 2000 });
        } else {
          startChat();
        }
      }, {{ chat_fallback_seconds | times: 1000 }});
    });
  })();
</script>
