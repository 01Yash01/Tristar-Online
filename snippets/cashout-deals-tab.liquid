{%- doc -%}
  Renders the Cash Out tab configured under Theme settings > Cash Out tab: a slim tab on the page's
  start edge, a third of the way down, that opens a panel linking to the Cash Out deals site. The
  panel opens beside the tab on larger screens and slides up from the bottom on phones. Renders
  nothing until a link is set. Without a logo picked, it uses cashout_logo.svg from the store's Files.

  @example
  {% render 'cashout-deals-tab' %}
{%- enddoc -%}

{%- liquid
  assign link = settings.cash_out_tab_link
  assign show_tab = false
  if settings.cash_out_tab_enabled and link != blank
    assign show_tab = true
  endif

  if show_tab
    assign logo = settings.cash_out_tab_logo
    if logo != blank
      assign logo_src = logo | image_url: width: 128
      assign logo_height = 64 | divided_by: logo.aspect_ratio | round
    else
      assign logo_src = 'cashout_logo.svg' | file_url
      assign logo_height = 64
    endif

    assign label = settings.cash_out_tab_label | strip
    assign hover_text = settings.cash_out_tab_hover_text | strip
    assign heading = settings.cash_out_tab_heading | strip

    # External links open in a new tab, and the site name shows under the button
    assign is_external = false
    if link contains '://'
      assign is_external = true
      assign site = link | split: '://' | last | split: '/' | first | split: '?' | first | remove_first: 'www.'
    endif
  endif
-%}

{%- if show_tab -%}
  <dialog-component class="cashout-tab cashout-tab--{{ settings.cash_out_tab_style }}{% unless settings.cash_out_tab_show_on_mobile %} cashout-tab--hide-on-mobile{% endunless %}">
    <button
      type="button"
      class="cashout-tab__tab"
      aria-haspopup="dialog"
      {% if label == blank %}
        aria-label="{{ heading | default: 'Cash Out' | escape }}"
      {% endif %}
      on:click="/showDialog"
    >
      <img
        class="cashout-tab__logo"
        src="{{ logo_src }}"
        alt=""
        width="64"
        height="{{ logo_height }}"
      >
      {%- if label != blank -%}
        <span class="cashout-tab__label">{{ label | escape }}</span>
      {%- endif -%}
      {%- if hover_text != blank -%}
        <span
          class="cashout-tab__hint"
          aria-hidden="true"
        >
          {{- hover_text | escape -}}
          <span class="cashout-tab__hint-arrow">→</span>
        </span>
      {%- endif -%}
    </button>

    <dialog
      ref="dialog"
      class="cashout-tab__panel"
      scroll-lock
      {% if heading != blank %}
        aria-labelledby="CashOutTabHeading"
      {% else %}
        aria-label="Cash Out"
      {% endif %}
    >
      <button
        type="button"
        class="cashout-tab__close"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
        on:click="/closeDialog"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>

      <img
        class="cashout-tab__panel-logo"
        src="{{ logo_src }}"
        alt=""
        width="64"
        height="{{ logo_height }}"
        loading="lazy"
      >

      {%- if settings.cash_out_tab_subheading != blank -%}
        <p class="cashout-tab__subheading">{{ settings.cash_out_tab_subheading | escape }}</p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2
          id="CashOutTabHeading"
          class="cashout-tab__heading"
        >
          {{ heading | escape }}
        </h2>
      {%- endif -%}

      {%- if settings.cash_out_tab_text != blank -%}
        <p class="cashout-tab__text">{{ settings.cash_out_tab_text | escape | newline_to_br }}</p>
      {%- endif -%}

      <a
        class="cashout-tab__button"
        href="{{ link }}"
        {% if is_external %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{- settings.cash_out_tab_button_label | default: site | escape -}}
        <span
          class="svg-wrapper cashout-tab__button-icon"
          aria-hidden="true"
        >
          {{- 'icon-external.svg' | inline_asset_content -}}
        </span>
        {%- if is_external -%}
          <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
        {%- endif -%}
      </a>

      {%- if site != blank -%}
        <p class="cashout-tab__site">{{ site | escape }}</p>
      {%- endif -%}
    </dialog>
  </dialog-component>
{%- endif -%}

{% stylesheet %}
  .cashout-tab {
    /* Cash Out's own colors, from its logo */
    --cashout-tab-green: #22e584;
    --cashout-tab-gold: #f5c451;
    --cashout-tab-ink: #0a0a0f;
    --cashout-tab-edge: linear-gradient(180deg, var(--cashout-tab-green), var(--cashout-tab-gold));
    --cashout-tab-surface: #ffffff;
    --cashout-tab-surface-hover: #f7f7f5;
    --cashout-tab-text: #0b1f44;
    --cashout-tab-top: 33%;
    --cashout-tab-width: 2.5rem;
    --cashout-tab-radius: 14px;
    --cashout-tab-shift: -6px;
    --cashout-tab-panel-shift: -16px;
  }

  .cashout-tab:dir(rtl) {
    --cashout-tab-shift: 6px;
    --cashout-tab-panel-shift: 16px;
  }

  .cashout-tab--black {
    --cashout-tab-surface: var(--cashout-tab-ink);
    --cashout-tab-surface-hover: #16161d;
    --cashout-tab-text: #ffffff;
  }

  /* The tab: high on the start edge so the bottom corners stay free, and narrow enough to sit in the
     page margin. A thin green-to-gold edge comes from the background clipped to the border box. */
  .cashout-tab__tab {
    position: fixed;
    inset-block-start: var(--cashout-tab-top);
    inset-inline-start: 0;
    z-index: var(--layer-sticky);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    inline-size: var(--cashout-tab-width);
    margin: 0;
    padding: 11px 0 13px;
    border: 1.5px solid transparent;
    border-inline-start: 0;
    border-start-end-radius: var(--cashout-tab-radius);
    border-end-end-radius: var(--cashout-tab-radius);
    background: linear-gradient(var(--cashout-tab-surface), var(--cashout-tab-surface)) padding-box,
      var(--cashout-tab-edge) border-box;
    color: var(--cashout-tab-text);
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.55), 0 2px 6px rgb(0 0 0 / 0.12);
    font: inherit;
    cursor: pointer;
    translate: 0 -50%;
    transition: inline-size var(--animation-speed-medium) var(--animation-timing-hover);
  }

  .cashout-tab__tab:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .cashout-tab__logo {
    display: block;
    inline-size: 1.625rem;
    block-size: auto;
    border-radius: 7px;
  }

  .cashout-tab__label {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-family: var(--font-body--family);
    font-size: 0.65625rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Computers: a short line slides out beside the tab on hover or keyboard focus */
  .cashout-tab__hint {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(100% + 10px);
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--cashout-tab-surface);
    color: var(--cashout-tab-text);
    box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(0 0 0 / 0.06);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    translate: var(--cashout-tab-shift) -50%;
    transition: opacity var(--animation-speed-slow) var(--animation-timing-default),
      translate var(--animation-speed-slow) var(--animation-timing-default),
      visibility 0s linear var(--animation-speed-slow);
  }

  .cashout-tab__hint-arrow {
    margin-inline-start: 0.5em;
  }

  .cashout-tab__hint-arrow:dir(rtl) {
    display: inline-block;
    scale: -1 1;
  }

  @media (hover: hover) and (min-width: 750px) {
    .cashout-tab__tab:hover {
      --cashout-tab-surface: var(--cashout-tab-surface-hover);

      inline-size: calc(var(--cashout-tab-width) + 4px);
    }

    .cashout-tab__tab:is(:hover, :focus-visible) .cashout-tab__hint {
      visibility: visible;
      opacity: 1;
      translate: 0 -50%;
      transition: opacity var(--animation-speed-slow) var(--animation-timing-default),
        translate var(--animation-speed-slow) var(--animation-timing-default), visibility 0s;
    }
  }

  @media (hover: none), (max-width: 749px) {
    .cashout-tab__hint {
      display: none;
    }
  }

  /* The panel: beside the tab on larger screens */
  .cashout-tab__panel {
    --cashout-panel-from: var(--cashout-tab-panel-shift) 0;

    inline-size: min(24rem, calc(100vw - 2rem));
    max-inline-size: none;
    max-block-size: calc(100dvh - 2rem);
    /* Lines the panel up with the tab, which sits a third of the way down */
    margin-block: max(1rem, calc(33dvh - 6rem)) auto;
    margin-inline: 4rem auto;
    padding: 30px 28px 24px;
    overflow: auto;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 20px;
    background: radial-gradient(120% 70% at 0% 0%, rgb(34 229 132 / 0.16), transparent 60%),
      radial-gradient(90% 60% at 100% 0%, rgb(245 196 81 / 0.14), transparent 60%), var(--cashout-tab-ink);
    color: #ffffff;
    box-shadow: 0 30px 80px -24px rgb(0 0 0 / 0.65);
    text-align: start;
  }

  .cashout-tab__panel::backdrop {
    background: rgb(10 10 15 / 0.42);
    backdrop-filter: blur(2px);
  }

  .cashout-tab__close {
    position: absolute;
    inset-block-start: 14px;
    inset-inline-end: 14px;
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #ffffff;
    cursor: pointer;
  }

  .cashout-tab__close:hover {
    background: rgb(255 255 255 / 0.16);
  }

  .cashout-tab__close svg {
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .cashout-tab__close:focus-visible,
  .cashout-tab__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .cashout-tab__panel-logo {
    display: block;
    inline-size: 3rem;
    block-size: auto;
    margin-block-end: 18px;
    border-radius: 12px;
  }

  .cashout-tab__subheading {
    margin: 0 0 8px;
    color: var(--cashout-tab-green);
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .cashout-tab__subheading {
      background: linear-gradient(90deg, var(--cashout-tab-green), var(--cashout-tab-gold));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .cashout-tab__heading {
    margin: 0 0 10px;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.6875rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .cashout-tab__text {
    margin: 0 0 22px;
    color: #c9c9cf;
    font-family: var(--font-body--family);
    font-size: 0.90625rem;
    line-height: 1.55;
  }

  .cashout-tab__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    inline-size: 100%;
    min-block-size: 50px;
    padding: 14px 20px;
    border-radius: 12px;
    background: linear-gradient(90deg, var(--cashout-tab-green), var(--cashout-tab-gold));
    color: var(--cashout-tab-ink);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: filter var(--animation-speed-medium) var(--animation-timing-hover);
  }

  .cashout-tab__button:hover {
    color: var(--cashout-tab-ink);
    filter: brightness(0.94);
  }

  .cashout-tab__button-icon {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .cashout-tab__button-icon:dir(rtl) {
    scale: -1 1;
  }

  .cashout-tab__site {
    margin: 12px 0 0;
    color: #8b8b95;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Phones: a slimmer tab a little lower, and the panel slides up from the bottom */
  @media screen and (max-width: 749px) {
    .cashout-tab {
      --cashout-tab-top: 58%;
      --cashout-tab-width: 1.875rem;
      --cashout-tab-radius: 12px;
    }

    .cashout-tab--hide-on-mobile {
      display: none;
    }

    .cashout-tab__tab {
      gap: 8px;
      padding-block: 9px 11px;
    }

    .cashout-tab__logo {
      inline-size: 1.25rem;
      border-radius: 6px;
    }

    .cashout-tab__label {
      font-size: 0.5625rem;
    }

    .cashout-tab__panel {
      --cashout-panel-from: 0 100%;

      inline-size: 100%;
      max-inline-size: 100%;
      max-block-size: calc(100dvh - 3rem);
      margin: auto 0 0;
      padding: 30px max(20px, var(--safe-area-inset-right)) max(24px, calc(16px + var(--safe-area-inset-bottom)))
        max(20px, var(--safe-area-inset-left));
      border-radius: 22px 22px 0 0;
      border-block-end: 0;
    }

    /* A handle marks the panel as a sheet; tapping outside or the close button closes it */
    .cashout-tab__panel::before {
      content: '';
      position: absolute;
      inset-block-start: 9px;
      inset-inline-start: 50%;
      inline-size: 40px;
      block-size: 4px;
      margin-inline-start: -20px;
      border-radius: 4px;
      background: rgb(255 255 255 / 0.22);
    }

    .cashout-tab__heading {
      font-size: 1.5625rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cashout-tab__panel[open] {
      animation: cashout-tab-panel-in var(--animation-speed-slow) var(--animation-timing-default) both;
    }

    .cashout-tab__panel.dialog-closing {
      animation: cashout-tab-panel-out var(--animation-speed-slow) var(--animation-timing-default) both;
    }

    .cashout-tab__panel[open]::backdrop {
      animation: cashout-tab-fade var(--animation-speed-slow) var(--animation-timing-default) both;
    }

    .cashout-tab__panel.dialog-closing::backdrop {
      animation: cashout-tab-fade var(--animation-speed-slow) var(--animation-timing-default) reverse both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cashout-tab__tab,
    .cashout-tab__hint,
    .cashout-tab__button {
      transition: none;
    }
  }

  @keyframes cashout-tab-panel-in {
    from {
      opacity: 0;
      translate: var(--cashout-panel-from);
    }
  }

  @keyframes cashout-tab-panel-out {
    to {
      opacity: 0;
      translate: var(--cashout-panel-from);
    }
  }

  @keyframes cashout-tab-fade {
    from {
      opacity: 0;
    }
  }
{% endstylesheet %}
