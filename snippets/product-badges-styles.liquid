{%- doc -%}
  Product badge styles consolidated into a single snippet.

  @example
  {% render 'product-badges-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-badges {
    --badge-inset: max(var(--padding-xs), calc((var(--border-radius) + var(--padding-xs)) * (1 - cos(45deg))));

    position: absolute;
    z-index: var(--layer-flat);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-2xs);
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    align-items: flex-end;
    top: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-end: calc(var(--badge-inset) + var(--padding-inline-end));
  }

  /* A compact, semibold label. The chosen badge font keeps its own weight when that is heavier */
  .product-badges__badge {
    --badge-font-size: var(--font-size--2xs);

    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: var(--badge-font-size);
    font-family: var(--badge-font-family);
    font-weight: max(var(--badge-font-weight, 400), 600);
    letter-spacing: 0.01em;
    text-transform: var(--badge-text-transform);
    border-radius: var(--badge-border-radius);
  }

  .product-badges__badge--rectangle {
    padding-block: var(--badge-rectangle-padding-block);
    padding-inline: var(--badge-rectangle-padding-inline);
  }
{% endstylesheet %}
