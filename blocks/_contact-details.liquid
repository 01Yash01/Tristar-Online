{%- doc -%}
  Renders the store's contact details for the Contact page section: phone and email as tap-to-call
  and tap-to-email links, the store address with an optional Google Maps directions link, warehouses,
  opening hours, and the business name with its ABN. Any detail left empty is not shown. Colors come
  from the section (--contact-page-details-* custom properties).

  @example
  {% content_for 'block', type: '_contact-details', id: 'details' %}
{%- enddoc -%}

{%- liquid
  assign s = block.settings

  assign phone_href = s.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign address_line = s.address | strip | newline_to_br | replace: '<br />', ', ' | strip_newlines | replace: ',,', ','
  assign encoded_address = address_line | url_encode
  # Opens Google Maps with a route from the shopper's location to the store (the app on phones)
  assign map_url = 'https://www.google.com/maps/dir/?api=1&destination=' | append: encoded_address
  assign abn_digits = s.abn | remove: ' '
-%}

{%- capture icon_phone -%}
  <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 4.7 4.7l1.3-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A14 14 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z"/></svg>
{%- endcapture -%}
{%- capture icon_mail -%}
  <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="14" height="11" rx="2"/><path d="m3.5 6 6.5 5 6.5-5"/></svg>
{%- endcapture -%}

<div
  class="contact-details"
  {{ block.shopify_attributes }}
>
  {%- if s.heading != blank -%}
    <h2 class="contact-details__heading">{{ s.heading | escape }}</h2>
  {%- endif -%}

  <ul
    class="contact-details__list list-unstyled"
    role="list"
  >
    {%- if s.phone != blank -%}
      <li class="contact-details__item">
        <span class="contact-details__icon">{{ icon_phone }}</span>
        <div class="contact-details__body">
          <p class="contact-details__label">{{ s.phone_label | escape }}</p>
          <a
            class="contact-details__value"
            href="tel:{{ phone_href }}"
          >
            {{- s.phone | escape -}}
          </a>
        </div>
      </li>
    {%- endif -%}

    {%- if s.email != blank -%}
      <li class="contact-details__item">
        <span class="contact-details__icon">{{ icon_mail }}</span>
        <div class="contact-details__body">
          <p class="contact-details__label">{{ s.email_label | escape }}</p>
          <a
            class="contact-details__value contact-details__value--email"
            href="mailto:{{ s.email | strip | escape }}"
          >
            {{- s.email | strip | escape -}}
          </a>
        </div>
      </li>
    {%- endif -%}

    {%- if s.address != blank -%}
      <li class="contact-details__item">
        <span class="contact-details__icon">
          <svg
            viewBox="0 0 20 20"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            {%- render 'icon', icon: 'map_pin' -%}
          </svg>
        </span>
        <div class="contact-details__body">
          <p class="contact-details__label">{{ s.address_label | escape }}</p>
          <address class="contact-details__value">{{ s.address | strip | escape | newline_to_br }}</address>
          {%- if s.show_directions_link and s.directions_text != blank -%}
            <a
              class="contact-details__link"
              href="{{ map_url }}"
              target="_blank"
              rel="noopener"
            >
              {{- s.directions_text | escape }}
              <span aria-hidden="true">→</span>
              <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
            </a>
          {%- endif -%}
        </div>
      </li>
    {%- endif -%}

    {%- if s.warehouses != blank -%}
      <li class="contact-details__item">
        <span class="contact-details__icon">
          <svg
            viewBox="0 0 20 20"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            {%- render 'icon', icon: 'truck' -%}
          </svg>
        </span>
        <div class="contact-details__body">
          <p class="contact-details__label">{{ s.warehouses_label | escape }}</p>
          <p class="contact-details__value">{{ s.warehouses | escape }}</p>
        </div>
      </li>
    {%- endif -%}

    {%- if s.hours != blank -%}
      <li class="contact-details__item">
        <span class="contact-details__icon">
          <svg
            viewBox="0 0 20 20"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            {%- render 'icon', icon: 'stopwatch' -%}
          </svg>
        </span>
        <div class="contact-details__body">
          <p class="contact-details__label">{{ s.hours_label | escape }}</p>
          <p class="contact-details__value">{{ s.hours | strip | escape | newline_to_br }}</p>
        </div>
      </li>
    {%- endif -%}
  </ul>

  {%- if s.business_name != blank or s.abn != blank -%}
    <p class="contact-details__legal">
      {%- if s.business_name != blank -%}
        <span>{{ s.business_name | escape }}</span>
      {%- endif -%}
      {%- if s.abn != blank -%}
        <span>ABN {{ s.abn | escape }}</span>
        {%- if s.show_abn_lookup and s.abn_lookup_text != blank -%}
          <a
            href="https://abr.business.gov.au/ABN/View?abn={{ abn_digits | url_encode }}"
            target="_blank"
            rel="noopener"
          >
            {{- s.abn_lookup_text | escape -}}
            <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
          </a>
        {%- endif -%}
      {%- endif -%}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .contact-details {
    display: grid;
    gap: 22px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--contact-page-radius, 16px);
    background: var(--contact-page-details-background, #0b1f44);
    color: var(--contact-page-details-text, #ffffff);
    min-width: 0;
  }

  .contact-details__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    line-height: 1.2;
  }

  .contact-details__list {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
  }

  .contact-details__item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .contact-details__icon {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--contact-page-accent, #e9c46a);
  }

  .contact-details__body {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .contact-details__label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .contact-details__value {
    margin: 0;
    color: inherit;
    font-size: 1rem;
    font-style: normal;
    font-weight: 600;
    line-height: 1.45;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.contact-details__value:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-details__link {
    justify-self: start;
    margin-block-start: 4px;
    color: var(--contact-page-accent, #e9c46a);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .contact-details__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-details__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    padding-block-start: 18px;
    border-block-start: 1px solid rgb(255 255 255 / 0.16);
    font-size: 0.875rem;
    opacity: 0.85;
  }

  .contact-details__legal a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .contact-details :is(a):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.contact_details",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.contact_details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Get in touch"
    },
    {
      "type": "header",
      "content": "t:content.phone"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "t:settings.label",
      "default": "Call us"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:settings.phone_number"
    },
    {
      "type": "header",
      "content": "t:content.email"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "t:settings.label",
      "default": "Email us"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:settings.email_address"
    },
    {
      "type": "header",
      "content": "t:content.address"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "t:settings.label",
      "default": "Visit our store"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:settings.address"
    },
    {
      "type": "checkbox",
      "id": "show_directions_link",
      "label": "t:settings.show_directions_link",
      "default": true
    },
    {
      "type": "text",
      "id": "directions_text",
      "label": "t:settings.link_text",
      "default": "Get directions",
      "visible_if": "{{ block.settings.show_directions_link }}"
    },
    {
      "type": "header",
      "content": "t:content.warehouses"
    },
    {
      "type": "text",
      "id": "warehouses_label",
      "label": "t:settings.label",
      "default": "Warehouses"
    },
    {
      "type": "text",
      "id": "warehouses",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.opening_hours"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "t:settings.label",
      "default": "Opening hours"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.business_details"
    },
    {
      "type": "text",
      "id": "business_name",
      "label": "t:settings.business_name"
    },
    {
      "type": "text",
      "id": "abn",
      "label": "t:settings.abn"
    },
    {
      "type": "checkbox",
      "id": "show_abn_lookup",
      "label": "t:settings.show_abn_lookup",
      "default": true
    },
    {
      "type": "text",
      "id": "abn_lookup_text",
      "label": "t:settings.link_text",
      "default": "ABN Lookup",
      "visible_if": "{{ block.settings.show_abn_lookup }}"
    }
  ]
}
{% endschema %}
