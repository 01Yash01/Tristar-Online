{%- doc -%}
  Renders one help link card in the Contact page section: an icon, a title and a short line of text.
  The whole card is one link; without a link it shows as a plain card.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign tag = 'div'
  if s.link != blank
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  class="contact-link"
  {% if tag == 'a' %}
    href="{{ s.link }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if s.icon != 'none' -%}
    <svg
      class="contact-link__icon"
      viewBox="0 0 20 20"
      width="24"
      height="24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      {%- render 'icon', icon: s.icon -%}
    </svg>
  {%- endif -%}
  <span class="contact-link__body">
    {%- if s.title != blank -%}
      <span class="contact-link__title">{{ s.title | escape }}</span>
    {%- endif -%}
    {%- if s.text != blank -%}
      <span class="contact-link__text">{{ s.text | escape }}</span>
    {%- endif -%}
  </span>
</{{ tag }}>

{% stylesheet %}
  .contact-link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 18px 20px;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: 14px;
    background: var(--contact-page-card-background, #ffffff);
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color var(--animation-speed-medium) var(--animation-timing-hover),
      box-shadow var(--animation-speed-medium) var(--animation-timing-hover);
  }

  a.contact-link:hover {
    border-color: rgb(var(--color-foreground-rgb) / var(--opacity-25));
    box-shadow: 0 10px 24px -16px rgb(0 0 0 / 0.35);
  }

  a.contact-link:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .contact-link__icon {
    flex: none;
    color: var(--contact-page-details-background, #0b1f44);
  }

  .contact-link__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .contact-link__title {
    font-weight: 600;
    line-height: 1.3;
  }

  .contact-link__text {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 0.875rem;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.help_link",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "box", "label": "t:options.box" },
        { "value": "truck", "label": "t:options.truck" },
        { "value": "return", "label": "t:options.return" },
        { "value": "question_mark", "label": "t:options.question_mark" },
        { "value": "chat_bubble", "label": "t:options.chat_bubble" },
        { "value": "shield", "label": "t:options.shield" },
        { "value": "clipboard", "label": "t:options.clipboard" },
        { "value": "map_pin", "label": "t:options.map_pin" }
      ],
      "default": "box"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Track your order"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "See where your parcel is"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.help_link"
    }
  ]
}
{% endschema %}
