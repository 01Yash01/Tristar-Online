

<div
  class="blog-post-content rte"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  /* Articles are often pasted in with large heading tags, so they're sized below the article title */
  .blog-post-content {
    --font-heading--spacing: 0.5em;
    --font-h1--size: var(--font-size--2xl);
    --font-h2--size: var(--font-size--2xl);
    --font-h3--size: var(--font-size--xl);
    --font-h4--size: var(--font-size--lg);
    --font-h5--size: var(--font-size--md);
    --font-h6--size: var(--font-size--md);
    --font-h1--line-height: var(--line-height--heading-normal);
    --font-h2--line-height: var(--line-height--heading-normal);
    --font-h3--line-height: var(--line-height--heading-normal);

    max-width: var(--blog-post-content-width, var(--normal-content-width));
    margin: 0 auto;
    color: var(--color, inherit);
    font-size: var(--font-size--md);
    line-height: var(--line-height--body-loose);
  }

  .blog-post-content a {
    color: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ],
  "presets": [
    {
      "name": "t:names.content",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}
