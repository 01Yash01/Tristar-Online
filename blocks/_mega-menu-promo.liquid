{%- doc -%}
  Renders one promotion card inside a header menu panel: an image with optional heading, text, and
  button label laid over it. The whole card is one link. The image renders on the deferred header
  hydration pass (and in the editor), so the first paint of every page stays light.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign image = block_settings.image

  assign render_media = false
  if section.index == blank or request.design_mode
    assign render_media = true
  endif

  assign tag = 'div'
  if block_settings.link != blank
    assign tag = 'a'
  endif

  # An image-only card still needs an accessible name for its link
  assign card_label = ''
  if block_settings.heading == blank and block_settings.text == blank and block_settings.button_label == blank
    assign card_label = image.alt
    if card_label == blank
      assign card_label = 'accessibility.view_link' | t
    endif
  endif
-%}

<{{ tag }}
  {% if tag == 'a' %}
    href="{{ block_settings.link }}"
  {% endif %}
  {% if card_label != blank and tag == 'a' %}
    aria-label="{{ card_label | escape }}"
  {% endif %}
  class="mega-promo mega-promo--{{ block_settings.content_position }} mega-promo--align-{{ block_settings.alignment }} mega-promo--text-{{ block_settings.text_color }}"
  style="--mega-promo-overlay: {{ block_settings.overlay_opacity | divided_by: 100.0 }};"
  {{ block.shopify_attributes }}
>
  <span class="mega-promo__media">
    {%- if image != blank -%}
      {%- if render_media -%}
        {{
          image
          | image_url: width: 1000
          | image_tag:
            widths: '320, 480, 640, 800, 1000',
            sizes: '(min-width: 990px) 33vw, 50vw',
            loading: 'lazy',
            alt: '',
            class: 'mega-promo__image'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'mega-promo__image mega-promo__image--placeholder' }}
    {%- endif -%}
  </span>

  {%- if block_settings.heading != blank or block_settings.text != blank or block_settings.button_label != blank -%}
    <span class="mega-promo__content">
      {%- if block_settings.heading != blank -%}
        <span class="mega-promo__heading">{{ block_settings.heading | escape }}</span>
      {%- endif -%}
      {%- if block_settings.text != blank -%}
        <span class="mega-promo__text">{{ block_settings.text | escape }}</span>
      {%- endif -%}
      {%- if block_settings.button_label != blank -%}
        <span class="mega-promo__button">
          {{- block_settings.button_label | escape -}}
          <span
            class="svg-wrapper mega-promo__button-icon"
            aria-hidden="true"
          >
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </span>
      {%- endif -%}
    </span>
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .mega-promo {
    --mega-promo-light: var(--color-white);
    --mega-promo-dark: rgb(17 17 17);

    position: relative;
    display: flex;
    isolation: isolate;

    /* clip (not hidden) keeps the minimum height automatic, so long text grows the card instead of being cut */
    overflow: clip;
    min-width: 0;
    aspect-ratio: var(--mega-promo-ratio, 16 / 10);
    border-radius: var(--mega-promo-radius, 12px);
    color: var(--mega-promo-light);
    text-decoration: none;
    white-space: normal;
  }

  .mega-promo--text-dark {
    color: var(--mega-promo-dark);
  }

  .mega-promo__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .mega-promo__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-cubic);
  }

  /* Overlay toward the text, for legibility; its strength is a block setting */
  .mega-promo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / var(--mega-promo-overlay)), transparent 75%);
    pointer-events: none;
  }

  .mega-promo--top::after {
    background: linear-gradient(to bottom, rgb(0 0 0 / var(--mega-promo-overlay)), transparent 75%);
  }

  .mega-promo--middle::after {
    background: rgb(0 0 0 / var(--mega-promo-overlay));
  }

  .mega-promo--text-dark::after {
    background: linear-gradient(to top, rgb(255 255 255 / var(--mega-promo-overlay)), transparent 75%);
  }

  .mega-promo__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: flex-end;
    gap: 6px;
    width: 100%;
    padding: clamp(16px, 2vw, 24px);
  }

  .mega-promo--top .mega-promo__content {
    align-self: flex-start;
  }

  .mega-promo--middle .mega-promo__content {
    align-self: center;
  }

  .mega-promo--align-center .mega-promo__content {
    align-items: center;
    text-align: center;
  }

  .mega-promo__heading {
    font-family: var(--menu-parent-font-family, inherit);
    font-size: clamp(1.05rem, 1.4vw, 1.375rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .mega-promo__text {
    font-size: var(--font-size--sm, 0.875rem);
    opacity: 0.9;
  }

  .mega-promo__button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background-color: var(--mega-promo-light);
    color: var(--mega-promo-dark);
    font-size: var(--font-size--sm, 0.8125rem);
    font-weight: 600;
  }

  .mega-promo--text-dark .mega-promo__button {
    background-color: var(--mega-promo-dark);
    color: var(--mega-promo-light);
  }

  .mega-promo__button-icon {
    display: flex;
    width: 14px;
    height: 14px;
    transition: transform 0.3s var(--ease-out-cubic);
  }

  [dir='rtl'] .mega-promo__button-icon {
    transform: scaleX(-1);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.mega-promo:hover .mega-promo__image {
      transform: scale(1.05);
    }

    a.mega-promo:hover .mega-promo__button-icon {
      transform: translateX(3px);
    }

    [dir='rtl'] a.mega-promo:hover .mega-promo__button-icon {
      transform: scaleX(-1) translateX(3px);
    }
  }

  a.mega-promo:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu_promo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.menu_promo_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.menu_promo_button_label",
      "default": "t:text_defaults.shop_now_button_label"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "middle",
          "label": "t:options.center"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "t:settings.text_color",
      "options": [
        {
          "value": "light",
          "label": "t:options.light"
        },
        {
          "value": "dark",
          "label": "t:options.menu_promo_dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.menu_promo"
    }
  ]
}
{% endschema %}
