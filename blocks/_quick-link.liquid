{%- doc -%}
  Renders one pill in the Quick links section: a round image or icon, a label, and a link.
  Picking a collection fills the label, link, and image automatically; each can be overridden.
  The pill is marked as the current page when its link matches the page being viewed.

  @example
  {% content_for 'block', type: '_quick-link', id: 'quick-link' %}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign collection = block_settings.collection

  assign label = block_settings.label | default: collection.title
  if label == blank and request.design_mode
    assign label = 'content.quick_link_placeholder' | t
  endif

  assign url = block_settings.link | default: collection.url

  assign image = block_settings.image | default: collection.featured_image
  if image == blank and collection != blank
    assign image = collection.products.first.featured_image
  endif

  assign is_active = false
  if url != blank and request.path == url
    assign is_active = true
  endif

  assign media_size = section.settings.image_size | default: 48
  assign image_sizes = media_size | append: 'px'
  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif
-%}

{%- if label != blank -%}
  <li
    class="quick-links__item"
    {{ block.shopify_attributes }}
  >
    <a
      {% if url != blank %}
        href="{{ url }}"
      {% endif %}
      class="quick-link{% if is_active %} quick-link--active{% endif %}"
      {% if is_active %}
        aria-current="page"
      {% endif %}
    >
      {%- case block_settings.media -%}
        {%- when 'image' -%}
          {%- if image != blank -%}
            <span class="quick-link__media">
              {{
                image
                | image_url: width: 192
                | image_tag:
                  widths: '64, 96, 128, 192',
                  sizes: image_sizes,
                  loading: image_loading,
                  alt: '',
                  class: 'quick-link__image'
              }}
            </span>
          {%- elsif request.design_mode -%}
            <span class="quick-link__media">
              {{ 'collection-1' | placeholder_svg_tag: 'quick-link__image' }}
            </span>
          {%- endif -%}
        {%- when 'icon' -%}
          <span class="quick-link__media quick-link__media--icon">
            <svg
              class="quick-link__icon"
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              {%- render 'icon', icon: block_settings.icon -%}
            </svg>
          </span>
      {%- endcase -%}

      <span class="quick-link__label">{{ label | escape }}</span>

      {%- if section.settings.show_arrow_icon -%}
        <span
          class="svg-wrapper quick-link__arrow"
          aria-hidden="true"
        >
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      {%- endif -%}
    </a>
  </li>
{%- endif -%}

